# =============================================================================
# GPanel Factory — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env no repositório.
# =============================================================================

# --- Supabase (obrigatório) ---
# Encontre em: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# --- Gemini AI (opcional) ---
# Necessário apenas se você usar funcionalidades de IA generativa.
GEMINI_API_KEY=sua-chave-gemini-aqui

# --- App (opcional) ---
APP_URL=http://localhost:3000
